    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@resume-parser/shared": "*",
    "amqplib": "^2.0.1",
    "compromise": "^14.17.0",
    "dotenv": "^18.0.1",
